{
  "endpoint": "http://127.0.0.1:8000/v1",
  "api_protocol": "configured_chat_completions",
  "credential_scope": {
    "endpoint": "http://127.0.0.1:8000/v1",
    "credential_id": "operator_local_key"
  },
  "role_model": "your-model-id",
  "tool_models": {
    "tool_a": "your-model-id"
  },
  "pricing_cny_per_million_tokens": {
    "your-model-id": [0, 0]
  },
  "pricing_evidence": "Example for a no-charge local endpoint. Record actual rates and their source for a billed endpoint.",
  "timeout_seconds": 180,
  "connect_timeout_seconds": 20,
  "max_attempts": 3,
  "max_calls_per_run": 150,
  "minimum_request_interval_seconds": 1,
  "response_transport": "nonstream",
  "generation_policy": {
    "version": "explicit-chat-completions-v1",
    "response_parsing": {
      "version": "terminal_json_delimiters_and_string_whitespace_v2",
      "required_finish_reason": "stop",
      "top_level": "single_object",
      "max_terminal_delimiters": 2,
      "allowed_operations": [
        "append_missing_terminal_closers",
        "remove_extra_terminal_closers",
        "escape_literal_string_whitespace"
      ],
      "edit_keys_values_strings_commas": false,
      "string_whitespace_encoding_only": ["LF", "CR", "TAB"],
      "decoded_string_characters_changed": false,
      "retry_model": false,
      "reject_duplicate_keys": true,
      "reject_nonfinite_constants": true
    },
    "models": {
      "your-model-id": {
        "thinking": false,
        "temperature": 0.2,
        "max_completion_tokens": 8192,
        "completion_limit_field": "max_tokens",
        "completion_limit_includes_reasoning": true,
        "context_window_tokens": 32768,
        "request_parameters": {}
      }
    }
  }
}
