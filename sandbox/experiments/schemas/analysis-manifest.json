{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinhospital.local/schemas/analysis-manifest.json",
  "title": "独立评价来源清单",
  "description": "分析目录名绑定输入证据及评价源码版本；引用文件原样复制。不覆盖平台seal或既有分析目录。",
  "x-contract-status": "implemented",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "$ref": "common.json#/$defs/longIdString"
    },
    "analysis_id": {
      "$ref": "common.json#/$defs/sha256"
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "common.json#/$defs/sha256"
      }
    },
    "artifacts": {
      "$ref": "common.json#/$defs/fileHashMap"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "analysis_id",
    "source_hashes",
    "artifacts"
  ],
  "additionalProperties": true
}
