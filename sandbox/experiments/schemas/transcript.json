        "case_id"
      ],
      "additionalProperties": true
    }
  ],
  "examples": [
    {
      "case_id": "demo-001",
      "segment_id": "demo-s0",
      "sequence": 0,
      "speaker_role": "patient",
      "start_ms": 0,
      "end_ms": 900,
      "available_at_ms": 1000,
      "text": "纯工程示例",
      "verified": true,
      "source_kind": "engineering_example"
    }
  ]
}
