{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinhospital.local/schemas/transcript.json",
  "title": "已核验转写逐段记录",
  "description": "相对时间单位毫秒；available_at_ms控制实时释放。verified=true不改变engineering_example来源。",
  "x-contract-status": "implemented-and-extensions",
  "allOf": [
    {
      "$ref": "common.json#/$defs/transcript"
    },
    {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "common.json#/$defs/longIdString"
        }
      },
