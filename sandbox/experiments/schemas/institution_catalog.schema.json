              }
            }
          }
        }
      },
      "verification": {
        "verification_id": "engineering-example-review",
        "verification_status": "pending_adjudication",
        "reviewers": [
          "example-operator"
        ],
        "verified_at": "2026-09-19T10:00:00+08:00",
        "content_sha256": "6182365b017b07df4c55b0edb7b27fae8b69d0e8c9097c7b118dc438009d533d",
        "source_artifacts": [
          {
            "path": "institution-source.example.json",
            "sha256": "73384d2ba3bc0f97a5b9bc3884a2f6286e50862a11e404b45683005e7ea821a4"
          }
        ]
      }
    }
  ]
}
