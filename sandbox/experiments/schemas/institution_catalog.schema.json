            }
          }
        },
        "diagnoses": {
          "TEST-DX": {
            "native_id": "501",
            "name": "Test diagnosis"
          }
        },
        "departments": {
          "TEST-DEPT": {
            "native_id": "601",
            "name": "Test department"
          }
        },
        "fees": {
          "201": {
            "drug_code": "TEST-A",
            "quantity_units": {
              "tablet": {
                "code": "U-TABLET",
                "min_units": "1",
                "unit_price": "2.50"
              }
            }
          }
        },
        "units": {
          "U-MG": {
            "name": "Test milligram"
          },
          "U-TABLET": {
            "name": "Test tablet"
          }
        },
        "inventory": {
          "301": {
            "drug_code": "TEST-A",
            "fee_id": "201",
            "location_id": "401",
            "lot_number": "TEST-LOT"
          }
        }
      },
      "native_mapping": {
        "schema_version": "1",
        "drugs": {
          "TEST-A": {
            "native": {
              "adviceDefinitionId": "101",
              "adviceTableName": "med_medication_definition",
              "definitionId": "201",
              "definitionDetailId": "301",
              "locationId": "401",
              "lotNumber": "TEST-LOT",
              "pharmacologyCategoryCode": "P1",
              "categoryCode": "C1",
              "skinTestFlag": 0,
              "injectFlag": 0
            },
            "dose_units": {
              "mg": "U-MG"
            },
            "routes": {
              "oral": "R-ORAL"
            },
            "frequencies": {
              "daily": "F-DAILY"
            },
            "quantity_units": {
