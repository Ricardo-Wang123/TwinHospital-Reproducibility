{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinhospital.local/schemas/case-assessment.json",
  "title": "独立评价病例结果",
  "description": "质量来自独立评价而非workflow自报；quality_basis=sealed_execution_failure仅表示失败不可能合格，不能解读为有人做过临床审核。",
  "x-contract-status": "implemented",
  "type": "object",
  "properties": {
    "case_id": {
      "$ref": "common.json#/$defs/longIdString"
    },
    "task": {
      "$ref": "common.json#/$defs/task"
    },
    "config_id": {
      "$ref": "common.json#/$defs/longIdString"
    },
    "environment": {
      "$ref": "common.json#/$defs/environment"
    },
    "source_group_id": {
      "$ref": "common.json#/$defs/longIdString"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "qualified": {
      "$ref": "common.json#/$defs/nullableBool"
    },
    "quality_source": {
      "const": "independent_review"
    },
    "quality_basis": {
      "type": "string",
      "minLength": 1
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_sha256": {
      "$ref": "common.json#/$defs/sha256"
    },
    "review_artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "fact-annotation.json"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stage_assessments": {
      "type": "object",
      "properties": {
        "first_handoff": {
          "$ref": "stage-assessment.json"
        },
        "first_draft": {
          "$ref": "stage-assessment.json"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "case_id",
    "task",
    "config_id",
    "environment",
    "source_group_id",
    "status",
    "qualified",
    "quality_source",
    "quality_basis",
    "artifact_sha256",
    "source_sha256",
    "review_artifact_id",
    "annotations",
    "missing"
  ],
  "additionalProperties": true
}
