{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinhospital.local/schemas/personnel-authorization.json",
  "title": "人员权限CSV行",
  "description": "长ID字符串。正式人员、操作权限、实例范围、有效版本必须来自实际授权材料，不得沿用示例人员。",
  "x-contract-status": "implemented-and-extensions",
  "type": "object",
  "properties": {
    "practitioner_id": {
      "$ref": "common.json#/$defs/longIdString"
    },
    "role": {
      "$ref": "common.json#/$defs/role"
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "practitioner_id",
    "role",
    "operation",
    "scope",
    "version"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "practitioner_id": "doctor-demo",
      "role": "doctor",
      "operation": "note.attest",
      "scope": "engineering_demo",
      "version": "demo-1"
    }
  ]
}
