{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinhospital.local/schemas/hospital-result-template.json",
  "title": "医院回传待填写模板",
  "description": "模板保留病例/配置/输入hash，真实来源、独立执行、时间和输出不预填。模板通过不代表可作为hospital-result导入。",
  "x-contract-status": "implemented-and-extensions",
  "type": "object",
  "properties": {
    "case_id": {
      "$ref": "common.json#/$defs/longIdString"
    },
    "config_id": {
      "$ref": "common.json#/$defs/longIdString"
    },
    "task": {
      "$ref": "common.json#/$defs/task"
    },
    "input_sha256": {
      "$ref": "common.json#/$defs/sha256"
    },
    "source_kind": {
      "enum": [
        "hospital_observed",
        null
      ]
    },
    "independent_execution": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hospital_execution_started_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "output": {},
    "final_output": {},
    "output_ref": {
      "$ref": "common.json#/$defs/relativePath"
    },
    "final_output_ref": {
      "$ref": "common.json#/$defs/relativePath"
    },
    "output_sha256": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "final_output_hash": {
      "$ref": "common.json#/$defs/sha256"
    },
    "final_output_sha256": {
      "$ref": "common.json#/$defs/sha256"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "common.json#/$defs/review"
      },
      "minItems": 0
    },
    "adjudication": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/adjudication"
        },
        {
          "type": "null"
        }
      ]
    },
    "attestation": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/attestation"
        },
        {
          "type": "null"
        }
      ]
    },
    "independent_execution_evidence": {
      "type": "object",
      "properties": {
        "operator_id": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/longIdString"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_run_id": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/longIdString"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_log_ref": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_log_sha256": {
          "anyOf": [
            {
              "$ref": "common.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operator_id",
        "source_run_id",
        "execution_log_ref",
        "execution_log_sha256"
      ],
      "additionalProperties": true
    },
    "potential_reuse": {
      "type": "boolean"
    },
    "encounter_ended_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "physician_attested_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "timeout",
        null
      ]
    },
    "final_decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "approve",
        "reject",
        "block",
        null
      ]
    },
    "hospital_execution_ended_at": {
      "anyOf": [
        {
          "$ref": "common.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "case_id",
    "config_id",
    "input_sha256",
    "source_kind",
    "independent_execution",
    "hospital_execution_started_at"
  ],
  "additionalProperties": true
}
